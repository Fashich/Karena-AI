# ================================================================
# Karena AI — Environment Configuration Template
# Copy: cp .env.example .env  (Linux/Mac)
#       copy .env.example .env  (Windows)
# JANGAN commit file .env — hanya .env.example yang di-commit
# ================================================================

ENVIRONMENT=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8080

# ── Vector Store ──────────────────────────────────────────────
# "memory"  = tidak butuh setup, data hilang saat restart (dev only)
# "qdrant"  = persistent, butuh Qdrant Cloud atau Docker
VECTOR_STORE=memory

# Qdrant Cloud (aktifkan jika VECTOR_STORE=qdrant)
# Daftar gratis di: https://cloud.qdrant.io
# QDRANT_URL=https://your-cluster.eu-central-1-0.aws.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key

# Qdrant lokal via Docker
# QDRANT_URL=http://localhost:6333

# ── Redis Cache (opsional) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/karena.db
AUDIT_DB_PATH=./data/audit.db

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── LLM Provider ──────────────────────────────────────────────
# Pilih SALAH SATU: mock | google | openai
#
# [mock]   Tidak butuh API key — response template (dev/test)
# [google] Butuh GOOGLE_API_KEY → https://aistudio.google.com/apikey
# [openai] Butuh OPENAI_API_KEY → https://platform.openai.com
#          Bisa dipakai untuk Groq (OpenAI-compatible):
#          OPENAI_BASE_URL=https://api.groq.com/openai/v1
#          OPENAI_MODEL=llama-3.3-70b-versatile

LLM_PROVIDER=mock

# Google Gemini
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_MODEL=gemini-2.0-flash

# OpenAI / Groq (OpenAI-compatible)
# OPENAI_API_KEY=your-openai-or-groq-api-key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# ── Security ──────────────────────────────────────────────────
REQUIRE_AUTH=false
JWT_SECRET=change-me-in-production-use-long-random-string

# OAuth2/OIDC SSO (opsional)
OAUTH2_PROVIDER=
OAUTH2_ISSUER=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=

# ── Multi-tenancy ─────────────────────────────────────────────
DEFAULT_TENANT_ID=default
