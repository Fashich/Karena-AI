# Karena AI Backend Configuration
ENVIRONMENT=development
DEBUG=true

# API (use 8080 if port 8000 is taken by Laragon/other apps)
API_HOST=127.0.0.1
API_PORT=8080

# Vector store: memory = no Docker needed | qdrant = requires docker compose
VECTOR_STORE=memory

# Services (only when VECTOR_STORE=qdrant or you want Redis cache)
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite+aiosqlite:///./data/karena.db

# CORS (frontend dev server)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM — use mock for local dev without API keys
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# LLM_PROVIDER=google
# GOOGLE_API_KEY=...
# GOOGLE_MODEL=gemini-2.0-flash

# Security (enable in production)
REQUIRE_AUTH=false
JWT_SECRET=change-me-in-production-use-long-random-string

# Multi-tenancy
DEFAULT_TENANT_ID=default
