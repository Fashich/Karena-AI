# ================================================================
# Karena AI — Environment Configuration Template
# Copy file ini ke .env dan isi nilai yang diperlukan
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env  (Windows)
# ================================================================

ENVIRONMENT=development
DEBUG=true

# API server
API_HOST=127.0.0.1
API_PORT=8080

# ── Vector Store ─────────────────────────────────────────────────
# "memory" = tidak butuh Docker, langsung jalan (default dev)
# "qdrant"  = butuh Docker: docker compose up qdrant
VECTOR_STORE=memory

# ── Services ──────────────────────────────────────────────────────
# Aktifkan hanya jika VECTOR_STORE=qdrant atau butuh Redis cache
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/karena.db
AUDIT_DB_PATH=./data/audit.db

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── LLM Provider ──────────────────────────────────────────────────
# Pilih SALAH SATU: mock | google | openai
#
# [mock]   Tidak butuh API key. Cocok untuk test tanpa biaya.
#          Response bersifat template, bukan generative AI.
#
# [google] Butuh GOOGLE_API_KEY. Aktifkan Gemini + Gemini Vision.
#          Dapatkan API key di: https://aistudio.google.com/apikey
#
# [openai] Butuh OPENAI_API_KEY. Aktifkan GPT-4o + GPT-4o Vision.
#          Dapatkan API key di: https://platform.openai.com/api-keys

LLM_PROVIDER=mock

# Google Gemini (aktifkan jika LLM_PROVIDER=google)
# GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_MODEL=gemini-2.0-flash

# OpenAI GPT (aktifkan jika LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# ── Security ──────────────────────────────────────────────────────
REQUIRE_AUTH=false
JWT_SECRET=change-me-in-production-use-long-random-string

# OAuth2/OIDC SSO (opsional — untuk enterprise SSO)
# Provider: azure_ad | okta | google
OAUTH2_PROVIDER=
OAUTH2_ISSUER=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=

# ── Multi-tenancy ─────────────────────────────────────────────────
DEFAULT_TENANT_ID=default
