# ================================================================
# Karena AI — Local Development Configuration
# JANGAN commit file ini ke git (.gitignore sudah handle)
# ================================================================

ENVIRONMENT=development
DEBUG=true

# API server
API_HOST=127.0.0.1
API_PORT=8080

# ── Vector Store ─────────────────────────────────────────────────
# "memory" = tidak butuh Docker, langsung jalan
# "qdrant"  = butuh Docker (docker compose up qdrant)
VECTOR_STORE=memory

# ── Services (aktifkan hanya jika VECTOR_STORE=qdrant) ───────────
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# ── Database (conversation memory) ───────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/karena.db
AUDIT_DB_PATH=./data/audit.db

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── LLM Provider ─────────────────────────────────────────────────
# Pilih SALAH SATU: mock | google | openai
# "mock" = tidak butuh API key, cocok untuk test cepat
# "google" = butuh GOOGLE_API_KEY, aktifkan Gemini Vision juga

LLM_PROVIDER=google
GOOGLE_API_KEY=ISI_API_KEY_GOOGLE_KAMU_DI_SINI
GOOGLE_MODEL=gemini-2.0-flash

# Uncomment jika pakai OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── Security ─────────────────────────────────────────────────────
REQUIRE_AUTH=false
JWT_SECRET=change-me-in-production-use-long-random-string

# OAuth2/OIDC SSO (opsional, kosongkan untuk dev)
OAUTH2_PROVIDER=
OAUTH2_ISSUER=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

# ── Multi-tenancy ─────────────────────────────────────────────────
DEFAULT_TENANT_ID=default
