apiVersion: 1

dashboard:
  title: Karena AI Platform Overview
  description: "Main dashboard for monitoring Karena AI platform health and performance"
  tags: ["karena-ai", "overview"]
  timezone: browser
  refresh: 30s
  panels:
    - id: 1
      title: "System Health Status"
      type: stat
      gridPos: {h: 4, w: 6, x: 0, y: 0}
      targets:
        - expr: up{job="karena-backend"}
          legendFormat: "Backend Status"
      thresholds:
        - value: 0
          color: red
        - value: 1
          color: green

    - id: 2
      title: "Request Rate (req/s)"
      type: graph
      gridPos: {h: 8, w: 12, x: 6, y: 0}
      targets:
        - expr: rate(http_requests_total[5m])
          legendFormat: "{{method}} {{endpoint}}"

    - id: 3
      title: "Error Rate (%)"
      type: graph
      gridPos: {h: 8, w: 12, x: 18, y: 0}
      targets:
        - expr: rate(http_requests_total{status=~"5.."}[5m]) / rate(http_requests_total[5m]) * 100
          legendFormat: "5xx Error Rate"

    - id: 4
      title: "Response Time P95 (ms)"
      type: graph
      gridPos: {h: 8, w: 12, x: 0, y: 8}
      targets:
        - expr: histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])) * 1000
          legendFormat: "P95 Latency"

    - id: 5
      title: "RAG Pipeline Duration (s)"
      type: graph
      gridPos: {h: 8, w: 12, x: 12, y: 8}
      targets:
        - expr: avg(rag_pipeline_duration_seconds)
          legendFormat: "Average RAG Duration"

    - id: 6
      title: "Cache Hit Ratio"
      type: gauge
      gridPos: {h: 6, w: 8, x: 0, y: 16}
      targets:
        - expr: rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))
      thresholds:
        - value: 0
          color: red
        - value: 0.5
          color: yellow
        - value: 0.8
          color: green

    - id: 7
      title: "Database Connections"
      type: graph
      gridPos: {h: 6, w: 8, x: 8, y: 16}
      targets:
        - expr: pg_stat_activity_count
          legendFormat: "Active Connections"
        - expr: pg_settings_max_connections
          legendFormat: "Max Connections"

    - id: 8
      title: "Vector Database Status"
      type: stat
      gridPos: {h: 6, w: 8, x: 16, y: 16}
      targets:
        - expr: qdrant_cluster_status
          legendFormat: "Cluster Status"
      thresholds:
        - value: 0
          color: red
        - value: 1
          color: green

    - id: 9
      title: "Active Users"
      type: stat
      gridPos: {h: 6, w: 6, x: 0, y: 22}
      targets:
        - expr: count(rate(user_requests_total[5m]) > 0)
          legendFormat: "Active Users"

    - id: 10
      title: "Documents Indexed"
      type: stat
      gridPos: {h: 6, w: 6, x: 6, y: 22}
      targets:
        - expr: count(document_chunks_total)
          legendFormat: "Total Chunks"

    - id: 11
      title: "LLM Token Usage"
      type: graph
      gridPos: {h: 6, w: 12, x: 12, y: 22}
      targets:
        - expr: sum(llm_tokens_used_total)
          legendFormat: "Total Tokens"

  schemaVersion: 38
  version: 1
